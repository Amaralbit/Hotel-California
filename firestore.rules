rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    // Troque pelo e-mail definido em dist/assets/firebase-config.js antes de publicar as regras.
    function isBootstrapOwner() {
      return signedIn() && request.auth.token.email == 'COLOQUE_O_EMAIL_DO_PROPRIETARIO_AQUI';
    }

    match /rooms/{roomId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isOwner());
      allow create: if request.auth.uid == userId &&
        isBootstrapOwner() && request.resource.data.role == 'owner';
      allow update, delete: if isOwner();
    }
  }
}
